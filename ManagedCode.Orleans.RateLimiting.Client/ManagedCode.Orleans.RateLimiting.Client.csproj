<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <!--NuGet-->
    <PropertyGroup>
        <Title>ManagedCode.Orleans.RateLimiting.Client</Title>
        <PackageId>ManagedCode.Orleans.RateLimiting.Client</PackageId>
        <Description>ASP.NET Core, SignalR, and Orleans client integration for distributed rate limiting.</Description>
        <PackageTags>orleans;rate-limiting;aspnetcore;signalr;distributed-rate-limiter;dotnet10</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Orleans.Client" />
        <PackageReference Include="System.Threading.RateLimiting" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ManagedCode.Orleans.RateLimiting.Core\ManagedCode.Orleans.RateLimiting.Core.csproj" />
    </ItemGroup>

</Project>
