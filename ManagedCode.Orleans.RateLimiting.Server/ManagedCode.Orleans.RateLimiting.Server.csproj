<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <!--NuGet-->
    <PropertyGroup>
        <Title>ManagedCode.Orleans.RateLimiting.Server</Title>
        <PackageId>ManagedCode.Orleans.RateLimiting.Server</PackageId>
        <Description>Orleans grains, silo filters, and server registration helpers for distributed rate limiting.</Description>
        <PackageTags>orleans;rate-limiting;orleans-silo;distributed-rate-limiter;dotnet10</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Orleans.Server" />
        <PackageReference Include="System.Threading.RateLimiting" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ManagedCode.Orleans.RateLimiting.Core\ManagedCode.Orleans.RateLimiting.Core.csproj" />
    </ItemGroup>

</Project>
